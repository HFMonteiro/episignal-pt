NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WORKER_API_URL=http://127.0.0.1:8088

# Episomer public RSS configuration.
# Keep these values server-side only. Do not prefix secrets with NEXT_PUBLIC_.
EPISOMER_R_WORKER_URL=http://127.0.0.1:8091
EPISOMER_TOPIC_CONFIG_PATH=../../config/episomer/topics.yml

# Explicit governance gates. Set to true only after local approval/documentation.
EPISOMER_GOV_DATA_PROTECTION_BASIS=false
EPISOMER_GOV_RETENTION_POLICY=false
EPISOMER_GOV_HUMAN_REVIEW=false
EPISOMER_GOV_AUDIT_LOG=false
